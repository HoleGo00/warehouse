{
  "name": "glorychips-warehouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "pnpm db:generate && pnpm -r --if-present build",
    "db:generate": "pnpm --filter @glorychips/database prisma:generate",
    "db:migrate": "cross-env DATABASE_URL=postgresql://warehouse:warehouse_local@localhost:54329/warehouse?schema=public pnpm --filter @glorychips/database prisma:migrate:deploy",
    "db:migrate:dev": "cross-env DATABASE_URL=postgresql://warehouse:warehouse_local@localhost:54329/warehouse?schema=public pnpm --filter @glorychips/database prisma:migrate:dev",
    "db:seed": "cross-env DATABASE_URL=postgresql://warehouse:warehouse_local@localhost:54329/warehouse?schema=public pnpm --filter @glorychips/database prisma:seed",
    "dev:api": "pnpm --filter @glorychips/api dev",
    "dev:web": "pnpm --filter @glorychips/web dev",
    "dev:worker": "pnpm --filter @glorychips/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "feishu:migration": "pnpm --filter @glorychips/worker exec tsx src/feishu/migration-command.ts",
    "lint": "eslint . --max-warnings 0",
    "postinstall": "pnpm db:generate",
    "test": "pnpm db:generate && vitest run --config vitest.config.ts",
    "test:integration": "pnpm db:migrate && pnpm db:seed && cross-env DATABASE_URL=postgresql://warehouse:warehouse_local@localhost:54329/warehouse?schema=public vitest run --config vitest.integration.config.ts",
    "typecheck": "pnpm db:generate && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "cross-env": "10.1.0",
    "eslint": "10.0.2",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1"
  }
}
