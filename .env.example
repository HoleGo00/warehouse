NODE_ENV=development
DATABASE_URL=postgresql://warehouse:warehouse_local@localhost:54329/warehouse?schema=public
API_PORT=3000
WEB_PUBLIC_URL=http://localhost:5173
FEISHU_APP_ID=cli_replace_with_real_app_id
FEISHU_APP_SECRET=replace_with_feishu_app_secret
FEISHU_ALLOWED_TENANT_KEY=replace_with_company_tenant_key
FEISHU_REDIRECT_URI=http://localhost:3000/auth/feishu/oauth/callback
INITIAL_ADMIN_FEISHU_USER_ID=replace_with_contact_api_user_id
SESSION_COOKIE_NAME=glorychips_session
OAUTH_BINDING_COOKIE_NAME=glorychips_oauth_binding
SESSION_TTL_SECONDS=28800
AUTH_STATE_TTL_SECONDS=600
WORKER_POLL_INTERVAL_MS=5000
WORKER_RUN_ONCE=false
FEISHU_SYNC_ENABLED=false
FEISHU_SYNC_ENVIRONMENT=FORMAL
# Set distinct Base tokens only when enabling synchronization.
# FEISHU_RING_BASE_TOKEN=
# FEISHU_WATCH_BASE_TOKEN=
LARK_CLI_EXECUTABLE=lark-cli
LARK_CLI_PROFILE=glorychips-warehouse
LARK_CLI_IDENTITY=user
LARK_CLI_EXPECTED_VERSION=1.0.91
LARK_CLI_TIMEOUT_MS=30000
LARK_CLI_MAX_OUTPUT_BYTES=8388608
OUTBOX_LEASE_MS=180000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=300000
WORKER_RECONCILE_INTERVAL_MS=300000
VITE_API_BASE_URL=http://localhost:3000
VITE_FEISHU_APP_ID=cli_replace_with_real_app_id
